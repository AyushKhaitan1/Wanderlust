<% layout("layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-12 col-lg-10 mx-auto">
    <!-- User Profile Header Card -->
    <div class="card p-4 border-0 shadow-sm rounded-4 mb-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 70px; height: 70px; font-size: 2rem; font-weight: 700;">
            <%= profileUser.username ? profileUser.username[0].toUpperCase() : 'U' %>
          </div>
          <div>
            <h3 class="fw-bold mb-0"><%= profileUser.name || profileUser.username %></h3>
            <p class="text-muted mb-0">
              <span>@<%= profileUser.username %></span> &middot;
              <span><i class="fa-regular fa-envelope me-1"></i><%= profileUser.email %></span>
            </p>
            <small class="text-secondary">
              <i class="fa-regular fa-calendar me-1"></i>Member since <%= new Date(profileUser.createdAt || Date.now()).toLocaleDateString("en-US", { month: "short", year: "numeric" }) %>
            </small>
          </div>
        </div>
        <div class="d-flex gap-2">
          <a href="/listings/new" class="btn btn-airbnb rounded-pill px-4">
            <i class="fa-solid fa-plus me-1"></i>Host a Stay
          </a>
        </div>
      </div>
    </div>

    <!-- Tab Navigation -->
    <ul class="nav nav-pills mb-4 gap-2" id="profileTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button
          class="nav-link rounded-pill px-4 <%= activeTab === 'bookings' ? 'active' : '' %>"
          id="bookings-tab"
          data-bs-toggle="pill"
          data-bs-target="#bookings-content"
          type="button"
          role="tab"
        >
          <i class="fa-solid fa-suitcase-rolling me-1"></i>My Bookings
          <span class="badge bg-secondary ms-1"><%= bookings.length %></span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button
          class="nav-link rounded-pill px-4 <%= activeTab === 'wishlist' ? 'active' : '' %>"
          id="wishlist-tab"
          data-bs-toggle="pill"
          data-bs-target="#wishlist-content"
          type="button"
          role="tab"
        >
          <i class="fa-solid fa-heart text-danger me-1"></i>My Wishlist
          <span class="badge bg-secondary ms-1"><%= wishlist.length %></span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button
          class="nav-link rounded-pill px-4 <%= activeTab === 'hosted' ? 'active' : '' %>"
          id="hosted-tab"
          data-bs-toggle="pill"
          data-bs-target="#hosted-content"
          type="button"
          role="tab"
        >
          <i class="fa-solid fa-house-chimney me-1"></i>My Hosted Stays
          <span class="badge bg-secondary ms-1"><%= hostedListings.length %></span>
        </button>
      </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="profileTabsContent">
      <!-- 1. Bookings Tab -->
      <div class="tab-pane fade <%= activeTab === 'bookings' ? 'show active' : '' %>" id="bookings-content" role="tabpanel">
        <% if (bookings.length === 0) { %>
          <div class="card text-center py-5 border-0 shadow-sm rounded-4">
            <div class="card-body">
              <i class="fa-solid fa-suitcase fa-3x text-muted mb-3"></i>
              <h4 class="fw-bold">No trips booked... yet!</h4>
              <p class="text-muted">Time to dust off your bags and start planning your next great adventure.</p>
              <a href="/listings" class="btn btn-airbnb rounded-pill px-4 mt-2">Start Exploring</a>
            </div>
          </div>
        <% } else { %>
          <div class="row g-4">
            <% for (let booking of bookings) { %>
              <% if (booking.listing) { %>
                <div class="col-12 col-md-6">
                  <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="row g-0 h-100">
                      <div class="col-4 position-relative">
                        <img
                          src="<%= booking.listing.image && booking.listing.image.url ? booking.listing.image.url : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=800&q=60' %>"
                          class="img-fluid h-100 w-100"
                          style="object-fit: cover;"
                          alt="<%= booking.listing.title %>"
                        />
                        <span class="badge bg-success position-absolute top-0 start-0 m-2 shadow-sm rounded-pill">
                          <i class="fa-solid fa-check-double me-1"></i>Confirmed
                        </span>
                      </div>
                      <div class="col-8">
                        <div class="card-body d-flex flex-column justify-content-between h-100 p-3">
                          <div>
                            <h6 class="fw-bold mb-1 text-truncate">
                              <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-body">
                                <%= booking.listing.title %>
                              </a>
                            </h6>
                            <p class="text-muted small mb-2">
                              <i class="fa-solid fa-location-dot me-1 text-danger"></i><%= booking.listing.location %>, <%= booking.listing.country %>
                            </p>
                            <div class="bg-body-secondary p-2 rounded-3 small mb-2">
                              <div><b>Dates:</b> <%= new Date(booking.checkin).toLocaleDateString("en-US", { month: "short", day: "numeric" }) %> &ndash; <%= new Date(booking.checkout).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></div>
                              <div><b>Guests:</b> <%= booking.guests %> &middot; <b>Nights:</b> <%= booking.nights %></div>
                            </div>
                          </div>
                          <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <div>
                              <small class="text-muted d-block">Total Paid</small>
                              <span class="fw-bold text-danger">&#8377; <%= booking.totalPrice ? booking.totalPrice.toLocaleString("en-IN") : 0 %></span>
                            </div>
                            <form method="POST" action="/bookings/<%= booking._id %>?_method=DELETE" onsubmit="return confirm('Cancel this reservation?');">
                              <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                Cancel
                              </button>
                            </form>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% } %>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- 2. Wishlist Tab -->
      <div class="tab-pane fade <%= activeTab === 'wishlist' ? 'show active' : '' %>" id="wishlist-content" role="tabpanel">
        <% if (wishlist.length === 0) { %>
          <div class="card text-center py-5 border-0 shadow-sm rounded-4">
            <div class="card-body">
              <i class="fa-regular fa-heart fa-3x text-danger mb-3"></i>
              <h4 class="fw-bold">Your wishlist is empty</h4>
              <p class="text-muted">As you search, tap the heart icon to save your favorite stays to this list.</p>
              <a href="/listings" class="btn btn-airbnb rounded-pill px-4 mt-2">Find Stays</a>
            </div>
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% for (let item of wishlist) { %>
              <div class="col">
                <div class="card listing-card h-100">
                  <div class="card-img-wrapper">
                    <a href="/listings/<%= item._id %>" class="listing-link">
                      <img
                        src="<%= item.image && item.image.url ? item.image.url : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=800&q=60' %>"
                        class="card-img-top"
                        alt="<%= item.title %>"
                      />
                    </a>
                  </div>
                  <div class="card-body">
                    <p class="card-text mb-1 text-truncate">
                      <b><%= item.title %></b>
                    </p>
                    <p class="card-location mb-1 text-muted small">
                      <%= item.location %>, <%= item.country %>
                    </p>
                    <p class="card-price mb-2">
                      &#8377; <%= item.price ? item.price.toLocaleString("en-IN") : 0 %> <span class="fw-normal text-muted small">/ night</span>
                    </p>
                    <a href="/listings/<%= item._id %>" class="btn btn-sm btn-outline-dark w-100 rounded-pill">
                      View Stay
                    </a>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- 3. Hosted Stays Tab -->
      <div class="tab-pane fade <%= activeTab === 'hosted' ? 'show active' : '' %>" id="hosted-content" role="tabpanel">
        <% if (hostedListings.length === 0) { %>
          <div class="card text-center py-5 border-0 shadow-sm rounded-4">
            <div class="card-body">
              <i class="fa-solid fa-house-laptop fa-3x text-muted mb-3"></i>
              <h4 class="fw-bold">You haven't listed any properties yet</h4>
              <p class="text-muted">Earn extra income and welcome guests by hosting your home on Wanderlust.</p>
              <a href="/listings/new" class="btn btn-airbnb rounded-pill px-4 mt-2">Create Your First Listing</a>
            </div>
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% for (let listing of hostedListings) { %>
              <div class="col">
                <div class="card listing-card h-100">
                  <div class="card-img-wrapper">
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                      <img
                        src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=800&q=60' %>"
                        class="card-img-top"
                        alt="<%= listing.title %>"
                      />
                    </a>
                  </div>
                  <div class="card-body">
                    <p class="card-text mb-1 text-truncate">
                      <b><%= listing.title %></b>
                    </p>
                    <p class="card-location mb-2 text-muted small">
                      <%= listing.location %>, <%= listing.country %>
                    </p>
                    <div class="d-flex gap-2 mt-2">
                      <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-pill">
                        <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                      </a>
                      <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-dark flex-grow-1 rounded-pill">
                        View
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
